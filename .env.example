# Copy to .env (git-ignored) and fill in. Never commit real values.

# Server-side SDK key for the "Test" environment of your LaunchDarkly project.
# Leave blank to run in fallback mode (infinite scroll,
# no events). Server-only: never put this in browser code.
LAUNCHDARKLY_SDK_KEY=

# Optional overrides (defaults shown).
# LAUNCHDARKLY_FLAG_KEY=shop-offer-list-experience
# SHOP_PAGE_SIZE=24
# IMPRESSION_VISIBLE_RATIO=0.5
# IMPRESSION_DWELL_MS=1000
